# Server Database Configurations
DATABASE_TYPE = {{ db_config }}
DATABASE_HOST = {{ database_host | default("localhost") }}
DATABASE_PORT = {{ database_port | default(5432 if db_config == "postgresql" else 3306) }}
DATABASE_USER = {{ database_user | default("app_user") }}
DATABASE_PASSWORD = {{ database_password | default("replace_with_password") }}
DATABASE_NAME = {{ database_name | default("app_db") }}
