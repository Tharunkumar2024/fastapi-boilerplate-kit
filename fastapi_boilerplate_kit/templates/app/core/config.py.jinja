"""
This module provides common configurations.
"""

# pylint: disable=E1136,E1131,W0108
# pylint: disable=invalid-name

from functools import lru_cache
from pydantic_settings import BaseSettings, SettingsConfigDict
from dotenv import load_dotenv
from app.core.constants import boolean_constants

load_dotenv(".env")


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=".env",
        env_ignore_empty=True,
        extra="ignore",
    )

    SET_ENV: str

    ADMIN_EMAIL: str
{% if with_auth %}
    ADMIN_PASSWORD: str = ""
{% endif %}

    ENABLE_SEED: str

    ALLOW_ORIGINS: str
    ALLOW_CREDENTIALS: str
    ALLOW_METHODS: str
    ALLOW_HEADERS: str
{% if with_auth %}
    AUTH_ENABLED: str = "FALSE"
    JWT_SECRET_KEY: str = ""
    JWT_ALGORITHM: str = "HS256"
    JWT_ACCESS_TOKEN_EXPIRE_MINUTES: int = 60
    JWT_REFRESH_TOKEN_EXPIRE_MINUTES: int = 43200
    JWT_RESET_TOKEN_EXPIRE_MINUTES: int = 30
    JWT_INVITE_TOKEN_EXPIRE_MINUTES: int = 10080
    FRONTEND_REGISTER_URL: str = ""
    FRONTEND_RESET_PASSWORD_URL: str = ""
{% endif %}
{% if with_email %}
    EMAIL_ENABLED: str = "FALSE"
    SMTP_HOST: str = ""
    SMTP_PORT: int = 587
    SMTP_USERNAME: str = ""
    SMTP_PASSWORD: str = ""
    SMTP_SENDER: str = ""
    SMTP_USE_TLS: str = "TRUE"
{% endif %}

    @property
    def CORS_ALLOW_ORIGINS(self) -> list[str]:
        return ["*"] if self.ALLOW_ORIGINS == "*" else self.ALLOW_ORIGINS.split()

    @property
    def CORS_ALLOW_CREDENTIALS(self) -> bool:
        return env_vars.ALLOW_CREDENTIALS != boolean_constants.FALSE

    @property
    def CORS_ALLOW_METHODS(self) -> list[str]:
        return ["*"] if self.ALLOW_METHODS == "*" else self.ALLOW_METHODS.split()

    @property
    def CORS_ALLOW_HEADERS(self) -> list[str]:
        return ["*"] if self.ALLOW_HEADERS == "*" else self.ALLOW_HEADERS.split()
{% if with_auth %}

    @property
    def is_auth_enabled(self) -> bool:
        return self.AUTH_ENABLED == boolean_constants.TRUE
{% endif %}
{% if with_email %}

    @property
    def is_email_enabled(self) -> bool:
        return self.EMAIL_ENABLED == boolean_constants.TRUE

    @property
    def is_smtp_tls_enabled(self) -> bool:
        return self.SMTP_USE_TLS == boolean_constants.TRUE
{% endif %}


settings = Settings()


@lru_cache
def get_settings():
    return settings


env_vars = get_settings()
