"""
This module provides user controller.
"""

# pylint: disable=E1136,E1131
# pylint: disable=invalid-name

from fastapi import APIRouter, Depends, status, Query
from fastapi.exceptions import HTTPException
from fastapi_pagination import Page, Params
from sqlalchemy.orm import Session
from pydantic import EmailStr
from app.services import UsersService
from app.schemas import (
    UserCreateDefaultRequest,
    UserUpdateDefaultRequest,
    UserStatusUpdateRequest,
    UserResponse,
    UserStatusUpdateResponse
)
from app.database.database import get_db
from app.schemas.commons import CommonResponse
{% if with_auth %}
from app.dependencies.auth import get_scope_context
from app.dependencies.authorization import require_any_role
from app.repositories.scopes import ScopeContext
from app.core.constants import role_constants
{% endif %}

router = APIRouter(prefix="/users")

API_TAG = 'Users'
RESPONSE_MODEL = UserResponse


def get_user_service(
    db: Session = Depends(get_db)
) -> UsersService:
    return UsersService(db)


@router.post('', tags=[API_TAG], response_model=CommonResponse[RESPONSE_MODEL])
async def create_user(
    user: UserCreateDefaultRequest = Depends(
        UserCreateDefaultRequest.as_form
    ),
{% if with_auth %}
    _: ScopeContext = Depends(require_any_role([role_constants.SU])),
{% endif %}
    user_service: UsersService = Depends(
        get_user_service
    )
) -> CommonResponse[UserResponse]:
    try:
        response = await user_service.create_user(
            user
        )
        return response
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=str(e)
        ) from e


@router.get(
    '',
    tags=[API_TAG],
    response_model=CommonResponse[
        Page[RESPONSE_MODEL]
    ]
)
async def get_all_users(
    params: Params = Depends(),
{% if with_auth %}
    scope_context: ScopeContext = Depends(get_scope_context),
    _: dict = Depends(require_any_role([role_constants.SU])),
{% endif %}
    user_service: UsersService = Depends(
        get_user_service
    )
) -> CommonResponse[Page[UserResponse]]:
    try:
        response = await user_service.get_all_users(
            params=params,
{% if with_auth %}
            scope_context=scope_context,
{% endif %}
        )
        return response
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=str(e)
        ) from e


@router.get(
    '/{_id}',
    tags=[API_TAG],
    response_model=CommonResponse[RESPONSE_MODEL]
)
async def get_user_by_id(
    _id: int,
{% if with_auth %}
    _: ScopeContext = Depends(require_any_role([role_constants.SU])),
{% endif %}
    user_service: UsersService = Depends(
        get_user_service
    )
) -> CommonResponse[UserResponse]:
    try:
        response = await user_service.get_user_by_id(_id)
        return response
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=str(e)
        ) from e


@router.patch(
    '/{_id}',
    tags=[API_TAG],
    response_model=CommonResponse[RESPONSE_MODEL]
)
async def update_user_by_id(
    _id: int,
    user: UserUpdateDefaultRequest = Depends(
        UserUpdateDefaultRequest.as_form
    ),
{% if with_auth %}
    _: ScopeContext = Depends(require_any_role([role_constants.SU])),
{% endif %}
    user_service: UsersService = Depends(
        get_user_service
    )
) -> CommonResponse[UserResponse]:
    try:
        response = await user_service.update_user_by_id(
            _id,
            user
        )
        return response
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=str(e)
        ) from e


