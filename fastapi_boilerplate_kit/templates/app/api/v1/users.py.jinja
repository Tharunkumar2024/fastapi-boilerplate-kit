        )
        return response
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=str(e)
        ) from e


@router.delete(
        '/{_id}',
        tags=[API_TAG],
        response_model=CommonResponse[RESPONSE_MODEL]
    )
async def delete_user_by_id(
    _id: int,
{% if with_auth %}
    _: ScopeContext = Depends(require_any_role([role_constants.SU])),
{% endif %}
    user_service: UsersService = Depends(
        get_user_service
    )
) -> CommonResponse[UserResponse]:
    try:
        response = await user_service.delete_user_by_id(_id)
        return response
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=str(e)
        ) from e
