"""
Optional initial SuperAdmin bootstrap from environment secrets.
"""

import secrets

from sqlalchemy.orm import Session
from app.models import User, Role
from app.core import env_vars
from app.repositories import RolesRepository
from app.security import hash_password


def _generate_bootstrap_password() -> str:
    """Random secret that satisfies app password-strength rules for change-password."""
    core = secrets.token_urlsafe(20)
    return f"{core}Aa1!"[:128]


def resolve_bootstrap_admin_password(admin_password: str | None) -> tuple[str, bool]:
    """
    Return (plaintext_password, was_generated).

    Empty or whitespace ADMIN_PASSWORD always yields a generated password;
    there is no "skip because password unset" path.
    """
    explicit = (admin_password or "").strip()
    if explicit:
        return explicit, False
    return _generate_bootstrap_password(), True


def seed_initial_admin(db: Session) -> None:
    """
    Create the first SuperAdmin: explicit ADMIN_PASSWORD if set, otherwise a
    one-time auto-generated password (empty password never skips bootstrap).

    Idempotent: skips if a user with ADMIN_EMAIL already exists, or if any
    SuperAdmin user already exists (single SuperAdmin policy).
    Only bcrypt hash is persisted; explicit or generated plaintext is never stored.
    """
    if not env_vars.is_auth_enabled:
        return

    admin_password_plain, used_generated_password = resolve_bootstrap_admin_password(
        env_vars.ADMIN_PASSWORD
    )

    admin_email = env_vars.ADMIN_EMAIL.lower().strip()
    role = db.query(Role).filter_by(name="SuperAdmin").first()
    if not role:
        raise ValueError("SuperAdmin role does not exist. Run role seed first.")

    role_repo = RolesRepository(db)
    if role_repo.count_users_with_role_name("SuperAdmin") >= 1:
        print("Initial admin skipped: a SuperAdmin user already exists.")
        return

    existing = db.query(User).filter_by(email=admin_email).first()
    if existing:
        print("Initial admin skipped: user already exists for ADMIN_EMAIL.")
        return

    user = User(
        username="Super Admin",
        firstname="Super",
        lastname="Admin",
        email=admin_email,
        password_hash=hash_password(admin_password_plain),
        is_active=True,
        is_email_verified=True,
        must_change_password=True,
        profile_image_url=None,
        role_id=role.id,
        created_by=1,
        updated_by=1,
    )
    db.add(user)
    db.commit()
    db.refresh(user)

    if used_generated_password:
        print("=" * 62)
        print(
            "WARNING: One-time bootstrap password printed below. "
            "It may appear in process logs—use for local/dev only; "
            "set ADMIN_PASSWORD after first login."
        )
        print("Log in and call POST /api/v1/auth/change-password immediately.")
        print(f"Email: {admin_email}")
        print(f"Temporary password: {admin_password_plain}")
        print("=" * 62)
    else:
        print("Initial SuperAdmin created from ADMIN_EMAIL / ADMIN_PASSWORD.")
