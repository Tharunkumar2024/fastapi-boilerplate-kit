{% if db_config == "sqlite" %}
{% include "partials/.env/database/sqlite_env_cnf.jinja" %}
{% else %}
{% include "partials/.env/database/server_env_cnf.jinja" %}
{% endif %}

# Environment configurations (PROD or DEV)
SET_ENV = PROD

# Admin Configurations
ADMIN_EMAIL = admin@example.com     # Replace with your admin mail
{% if with_auth %}
# Bootstrap: set a fixed password, or leave empty (always auto-generates a one-time password on first seed; never skipped).
ADMIN_PASSWORD =
{% endif %}

# Seed Configurations (TRUE or FALSE)
ENABLE_SEED = TRUE

# CORS Configurations (Use ','(comma) to separate the list values)
ALLOW_ORIGINS = *
ALLOW_CREDENTIALS = FALSE
ALLOW_METHODS = *
ALLOW_HEADERS = *
{% if with_auth %}
# JWT Configurations
AUTH_ENABLED = TRUE
JWT_SECRET_KEY = replace_with_strong_secret
JWT_ALGORITHM = HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES = 43200
JWT_RESET_TOKEN_EXPIRE_MINUTES = 30
JWT_INVITE_TOKEN_EXPIRE_MINUTES = 10080
FRONTEND_REGISTER_URL = http://localhost:3000/register
FRONTEND_RESET_PASSWORD_URL = http://localhost:3000/reset-password
{% endif %}
{% if with_email %}
# SMTP Configurations
EMAIL_ENABLED = TRUE
SMTP_HOST = smtp.example.com
SMTP_PORT = 587
SMTP_USERNAME = user@example.com
SMTP_PASSWORD = replace_with_password
SMTP_SENDER = noreply@example.com
SMTP_USE_TLS = TRUE
{% endif %}
